+
+  // ======================= WORLD vocoder =======================
+  // Mel-cepstrum -> power spectrum: log|H| = sum_m c_m cos(m * warped(w)),
+  // band aperiodicity (7 bands, as linear power weights) -> per-bin amplitude.
+  // WORLD generates the aperiodic part pulse by pulse, i.e. pitch-synchronously.
+
+  void hts_vocoder_wrapper::world_init()
+  {
+    const int fs=HTS_Engine_get_sampling_frequency(engine);
+    const int fp=HTS_Engine_get_fperiod(engine);
+    const int nspec=HTS_ModelSet_get_vector_length(&engine->ms, 0);
+    const int nbap=HTS_ModelSet_get_vector_length(&engine->ms, 2);
+    const double alpha=engine->condition.alpha;
+    world_fft=(fs>32000)?2048:1024;
+    const int nb=world_fft/2+1;
+    world_cos.assign(nb*nspec, 0.0);
+    for(int k=0; k<nb; ++k)
+      {
+        const double w=M_PI*k/(nb-1);
+        const double ww=w+2.0*std::atan(alpha*std::sin(w)/(1.0-alpha*std::cos(w)));
+        for(int m=0; m<nspec; ++m)
+          world_cos[k*nspec+m]=std::cos(m*ww);
+      }
+    // band centres (Hz) of the 7-band set used by our voices; generic split otherwise
+    std::vector<double> cent;
+    if(nbap==7)
+      cent={500, 1500, 3000, 5000, 7000, 9000, 11000};
+    else
+      for(int i=0; i<nbap; ++i)
+        cent.push_back((i+0.5)*fs/2.0/nbap);
+    world_bapw.assign(nb*2, 0.0);   // for each bin: lower band index, weight of upper band
+    for(int k=0; k<nb; ++k)
+      {
+        const double f=0.5*fs*k/(nb-1);
+        int i=0;
+        while(i+1<nbap && cent[i+1]<f) ++i;
+        double t=0;
+        if(i+1<nbap && f>cent[i])
+          t=(f-cent[i])/(cent[i+1]-cent[i]);
+        if(t<0) t=0;
+        if(t>1) t=1;
+        world_bapw[2*k]=i;
+        world_bapw[2*k+1]=(i+1<nbap)?t:0.0;
+      }
+    auto* s=new WorldSynthesizer;
+    InitializeSynthesizer(fs, 1000.0*fp/fs, world_fft, fp, 4096, s);
+    ws=s;
+  }
+
+  void hts_vocoder_wrapper::world_clear()
+  {
+    if(ws!=nullptr)
+      {
+        auto* s=static_cast<WorldSynthesizer*>(ws);
+        DestroySynthesizer(s);
+        delete s;
+        ws=nullptr;
+      }
+    world_frames.clear();
+    world=false;
+  }
+
+  void hts_vocoder_wrapper::world_frame(const frame_t& f, double lf0)
+  {
+    auto* s=static_cast<WorldSynthesizer*>(ws);
+    const int nspec=f.spec.size();
+    const int nb=world_fft/2+1;
+    std::unique_ptr<world_frame_t> wf(new world_frame_t);
+    wf->f0[0]=f.voiced?std::exp(lf0):0.0;
+    // spectral envelope with cepstral postfilter (HTS-style beta, energy preserved)
+    std::vector<double> c(f.spec.begin(), f.spec.end());
+    const double beta=engine->condition.beta;
+    wf->sp.assign(nb, 0.0);
+    std::vector<double> la(nb, 0.0);
+    double e0=0, e1=0;
+    for(int k=0; k<nb; ++k)
+      {
+        double a=0;
+        for(int m=0; m<nspec; ++m) a+=c[m]*world_cos[k*nspec+m];
+        la[k]=a; e0+=std::exp(2*a);
+      }
+    if(beta!=0)
+      {
+        for(int k=0; k<nb; ++k)
+          {
+            double d=0;
+            for(int m=2; m<nspec; ++m) d+=beta*c[m]*world_cos[k*nspec+m];
+            la[k]+=d; e1+=std::exp(2*la[k]);
+          }
+        const double g=0.5*std::log(e0/e1);
+        for(int k=0; k<nb; ++k) la[k]+=g;
+      }
+    for(int k=0; k<nb; ++k)
+      wf->sp[k]=std::exp(2*la[k]);
+    // aperiodicity (amplitude): bap arrives as linear power weights
+    wf->ap.assign(nb, 1.0);
+    if(f.voiced)
+      {
+        const int nbap=f.bap.size();
+        for(int k=0; k<nb; ++k)
+          {
+            const int i=static_cast<int>(world_bapw[2*k]);
+            const double t=world_bapw[2*k+1];
+            const double lo=10.0*std::log10(std::max(f.bap[i], 1e-10));
+            const double hi=(i+1<nbap)?10.0*std::log10(std::max(f.bap[i+1], 1e-10)):lo;
+            const double db=(1-t)*lo+t*hi;
+            double a=std::pow(10.0, db/20.0);
+            if(a<0.001) a=0.001;
+            if(a>1) a=1;
+            wf->ap[k]=a;
+          }
+      }
+    wf->spp[0]=wf->sp.data();
+    wf->app[0]=wf->ap.data();
+    while(AddParameters(wf->f0, 1, wf->spp, wf->app, s)==0)
+      {
+        if(Synthesis2(s)==0)
+          {
+            if(IsLocked(s)) RefreshSynthesizer(s);
+            break;
+          }
+        world_drain();
+      }
+    wf->pointer=s->head_pointer;
+    world_frames.push_back(std::move(wf));
+    world_drain();
+  }
+
+  void hts_vocoder_wrapper::world_drain()
+  {
+    auto* s=static_cast<WorldSynthesizer*>(ws);
+    const double vol=engine->condition.volume;
+    while(Synthesis2(s)!=0)
+      {
+        for(int i=0; i<s->buffer_size; ++i)
+          {
+            double x=s->buffer[i]*vol;
+            if(x>32767) x=32767;
+            if(x<-32768) x=-32768;
+            HTS_Audio_write(&engine->audio, static_cast<short>(x));
+          }
+        if(engine->condition.stop)
+          return;
+      }
+    // frames whose buffers WORLD has released can go
+    while(!world_frames.empty() && world_frames.front()->pointer + 2 < s->current_pointer2)
+      world_frames.pop_front();
+  }
+
+  void hts_vocoder_wrapper::world_flush()
+  {
+    // push a little silence so the last real frames are synthesized
+    frame_t z;
+    z.voiced=false;
+    z.spec.assign(HTS_ModelSet_get_vector_length(&engine->ms, 0), 0.0);
+    z.spec[0]=-10.0;
+    z.bap.assign(HTS_ModelSet_get_vector_length(&engine->ms, 2), 1.0);
+    for(int i=0; i<8; ++i)
+      world_frame(z, 0.0);
+  }
 }
