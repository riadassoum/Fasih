+  void hts_vocoder_wrapper::ms_load(const std::string& path)
+  {
+    std::ifstream in(path);
+    if(!in)
+      return;
+    std::size_t d=0, k=0;
+    if(!(in>>d>>k>>ms_frame_rate) || d==0 || k<2)
+      return;
+    std::vector<std::vector<double>> g(d, std::vector<double>(k, 1.0));
+    for(auto& row: g)
+      for(auto& v: row)
+        if(!(in>>v))
+          return;
+    ms_step=(ms_frame_rate/2.0)/static_cast<double>(k-1);
+    ms_gain.swap(g);
+  }
+
+  namespace
+  {
+    void fft(std::vector<std::complex<double>>& a, bool inverse)
+    {
+      const std::size_t n=a.size();
+      for(std::size_t i=1, j=0; i<n; ++i)
+        {
+          std::size_t bit=n>>1;
+          for(; j&bit; bit>>=1)
+            j^=bit;
+          j^=bit;
+          if(i<j)
+            std::swap(a[i], a[j]);
+        }
+      for(std::size_t len=2; len<=n; len<<=1)
+        {
+          const double ang=2*M_PI/static_cast<double>(len)*(inverse?1:-1);
+          const std::complex<double> wl(std::cos(ang), std::sin(ang));
+          for(std::size_t i=0; i<n; i+=len)
+            {
+              std::complex<double> w(1);
+              for(std::size_t j=0; j<len/2; ++j)
+                {
+                  const auto u=a[i+j], v=a[i+j+len/2]*w;
+                  a[i+j]=u+v;
+                  a[i+j+len/2]=u-v;
+                  w*=wl;
+                }
+            }
+        }
+      if(inverse)
+        for(auto& x: a)
+          x/=static_cast<double>(n);
+    }
+  }
+
+  // The spectral trajectory of the whole generation window, each coefficient filtered in the
+  // modulation-frequency domain (mean kept, the window mirrored at both ends to avoid edges).
+  void hts_vocoder_wrapper::ms_filter()
+  {
+    ms_spec.clear();
+    if(ms_gain.empty())
+      return;
+    auto* pss=&engine->pss;
+    const std::size_t T=HTS_PStreamSet_get_total_frame(pss);
+    const std::size_t D=std::min<std::size_t>(HTS_PStreamSet_get_vector_length(pss, 0), ms_gain.size());
+    const std::size_t nspec=HTS_PStreamSet_get_vector_length(pss, 0);
+    if(T<8)
+      return;
+    ms_spec.resize(T);
+    for(std::size_t t=0; t<T; ++t)
+      {
+        auto v=HTS_PStreamSet_get_parameter_vector(pss, 0, t);
+        ms_spec[t].assign(v, v+nspec);
+      }
+    const std::size_t pad=std::min<std::size_t>(T-1, 64);
+    std::size_t n=1;
+    while(n<T+2*pad)
+      n<<=1;
+    std::vector<std::complex<double>> a(n);
+    const auto& g0=ms_gain[0];
+    for(std::size_t d=0; d<D; ++d)
+      {
+        double mean=0;
+        for(std::size_t t=0; t<T; ++t)
+          mean+=ms_spec[t][d];
+        mean/=static_cast<double>(T);
+        std::fill(a.begin(), a.end(), std::complex<double>(0));
+        for(std::size_t i=0; i<T+2*pad; ++i)
+          {
+            long t=static_cast<long>(i)-static_cast<long>(pad);
+            if(t<0) t=-t;
+            if(t>=static_cast<long>(T)) t=2*(static_cast<long>(T)-1)-t;
+            a[i]=ms_spec[t][d]-mean;
+          }
+        fft(a, false);
+        const auto& g=ms_gain[d];
+        for(std::size_t b=1; b<=n/2; ++b)
+          {
+            const double hz=ms_frame_rate*static_cast<double>(b)/static_cast<double>(n);
+            const double pos=hz/ms_step;
+            std::size_t k=static_cast<std::size_t>(pos);
+            double gain;
+            if(k+1>=g.size())
+              gain=g.back();
+            else
+              {
+                const double fr=pos-static_cast<double>(k);
+                gain=g[k]*(1-fr)+g[k+1]*fr;
+              }
+            a[b]*=gain;
+            if(b!=n-b)
+              a[n-b]*=gain;
+          }
+        fft(a, true);
+        for(std::size_t t=0; t<T; ++t)
+          ms_spec[t][d]=a[t+pad].real()+mean;
+      }
+    (void)g0;
+  }
